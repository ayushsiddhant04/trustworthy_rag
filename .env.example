# Privacy: all external calls are disabled by default.
ENABLE_EXTERNAL_LLM=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Retrieval. TF-IDF works offline. Install requirements-verification.txt and
# set ENABLE_EMBEDDINGS=true to activate all-MiniLM-L6-v2 hybrid retrieval.
ENABLE_EMBEDDINGS=false
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TFIDF_WEIGHT=0.5
RETRIEVAL_EMBED_WEIGHT=0.5
RETRIEVAL_DEFAULT_K=3

# Chunking
CHUNK_SIZE_WORDS=120
CHUNK_OVERLAP_WORDS=30

# Cache and logging
CACHE_MAX_ITEMS=256
CACHE_TTL_SECONDS=1800
LOG_LEVEL=INFO
