# Production Dockerfile for Evidence Review (Vercel Container Runtime)
FROM python:3.12-slim

# Prevent Python from writing .pyc files and configure runtime environment
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    VERCEL=1 \
    DEPLOYMENT_TARGET=vercel \
    MAX_UPLOAD_SIZE_MB=4 \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_ENABLE_CORS=true \
    STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION=true \
    STREAMLIT_SERVER_MAX_UPLOAD_SIZE=4 \
    HF_HUB_ENABLE_HF_TRANSFER=0

# Install minimal OS runtime packages required for document parsing and certificates
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency definition to temporary staging directory for system installation
WORKDIR /tmp/build
COPY requirements.txt /tmp/build/

# Step 1: Install CPU-only PyTorch into the global system Python environment as root
RUN python -m pip install --no-cache-dir --upgrade pip && \
    python -m pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Step 2: Install remaining production requirements into the global environment using the same interpreter
RUN python -m pip install --no-cache-dir -r /tmp/build/requirements.txt

# Step 3: Mandatory build-time validation as root: PyTorch is CPU-only, Streamlit is 1.67.0, and pip check passes
RUN python -c "import sys, streamlit, torch; \
    print('Root Python:', sys.executable); \
    print('Root Streamlit:', streamlit.__version__); \
    print('Root Streamlit location:', streamlit.__file__); \
    print('Root PyTorch:', torch.__version__); \
    print('Root CUDA:', torch.version.cuda); \
    assert streamlit.__version__ == '1.67.0', f'Expected Streamlit 1.67.0, got {streamlit.__version__}'; \
    assert torch.version.cuda is None, f'Expected CPU build, got CUDA {torch.version.cuda}'" && \
    python -m pip check && \
    python -m streamlit --version

# Step 4: Create non-root user (UID 1000) and prepare user-owned model cache and application directories
RUN useradd -m -u 1000 user && \
    mkdir -p /home/user/.cache/huggingface && \
    mkdir -p /home/user/.cache/torch && \
    mkdir -p /home/user/app && \
    chown -R user:user /home/user && \
    rm -rf /tmp/build

ENV HOME=/home/user \
    HF_HOME=/home/user/.cache/huggingface \
    TRANSFORMERS_CACHE=/home/user/.cache/huggingface/hub \
    TORCH_HOME=/home/user/.cache/torch

# Switch to non-root user for application runtime
USER user
WORKDIR /home/user/app

# Step 5: Mandatory validation as non-root user: confirm Streamlit and PyTorch import cleanly
RUN python -c "import sys, streamlit, torch; \
    print('User Python:', sys.executable); \
    print('User Streamlit:', streamlit.__version__); \
    print('User Streamlit location:', streamlit.__file__); \
    print('User PyTorch:', torch.__version__); \
    print('User CUDA:', torch.version.cuda); \
    assert streamlit.__version__ == '1.67.0', f'Expected Streamlit 1.67.0, got {streamlit.__version__}'; \
    assert torch.version.cuda is None, f'Expected CPU build, got CUDA {torch.version.cuda}'" && \
    python -m streamlit --version

# Pre-download both models directly into user-owned HF_HOME during build
# Eliminates cold-start latency and avoids outbound runtime Hugging Face Hub calls
RUN python -c "from sentence_transformers import CrossEncoder, SentenceTransformer; \
    CrossEncoder('cross-encoder/nli-deberta-v3-base'); \
    SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')"

# Copy application source code, configuration, demo fixtures, and research artifacts
COPY --chown=user:user . /home/user/app

# Expose default HTTP container port
EXPOSE 80

# Launch production Streamlit application dynamically binding to ${PORT:-80}
# Invokes via python -m streamlit to guarantee execution through the verified Python interpreter
CMD ["sh", "-c", "python -m streamlit run app.py --server.port=${PORT:-80} --server.address=0.0.0.0 --server.headless=true --server.enableCORS=true --server.enableXsrfProtection=true --server.maxUploadSize=4"]
